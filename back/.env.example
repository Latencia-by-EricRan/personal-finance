# MongoDB connection URI. Replace credentials/host when using Atlas or another server.
MONGO_CONN_STR=mongodb://127.0.0.1:27017

# Database name used by this application.
MONGO_DB_NAME=personal_finance

# HTTP port. The application defaults to 80 when omitted.
PORT=3000

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Email for the single user allowed to authenticate.
AUTH_EMAIL=user@example.com

# bcrypt password hash. Generate it with: npm run hash-password <plain-password>
AUTH_PASSWORD_HASH=$2b$12$REPLACE_WITH_GENERATED_BCRYPT_HASH

# JWT signing secret. Replace with a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# JWT lifetime. Format: <number>[s|m|h|d].
JWT_EXPIRES_IN=1d
