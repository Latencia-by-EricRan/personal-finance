{
  "name": "back",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/e2e",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "hash-password": "ts-node scripts/hash-password.ts",
    "backfill-movement-accounts": "ts-node scripts/backfill-movement-accounts.ts",
    "env:check": "ts-node scripts/validate-env.ts",
    "seed": "ts-node scripts/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "Eric Alberto Rangel Carmona",
  "license": "ISC",
  "description": "Aplicación de backend con TypeScript y Express - Finanzas Personales",
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "js-yaml": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.8.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.4",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
